# ---- 密钥（绝不入库）----
.env

# ---- Python ----
__pycache__/
*.py[cod]

# ---- 索引与向量产物（体积大，可一键重建）----
# 重建命令见 README：python src/chunking.py && python src/bm25_index.py && python src/vector_index.py
data/faiss_index.bin
data/faiss_index.meta.json
data/faiss_index.tfidf_svd.pkl
data/bm25_index.pkl
# B2 kb 级索引（9/30 最优组合，可重建：python src/build_kb_index.py）
data/faiss_index_kb.bin
data/faiss_index_kb.meta.json
data/bm25_index_kb.pkl
data/chroma_db/
data/_backup_*/
data/*.backup_*

# ---- 实验中间产物 ----
exp/*.npy
# ⚠️ P1 特征/图像缓存：**4.3 GB**（4 个 x_V*.npy 各 1.15 GB + DINOv2 特征），
#    全部可由脚本一键重建，进了仓库会撑爆 git 历史。
#    重建：python -m src.vision.calibrate_dedup / python exp/d3_intervention.py
exp/_cache/

# ---- LLM 调用缓存（可重建，避免重复烧 token 的本地缓存）----
data/rewrite_cache.json
data/rerank_cache.json
data/reject_cache.json
data/answer_cache.json
data/answer_cache_v28.json
data/judge_e2e_cache.json
data/backfill_cache.json
data/judge_lenient_cache.json
data/judge_audit_cache.json
data/_kb016_verify_cache.json
exp/exp_e2e_result.json
exp/_*.pkl

# ---- P1 视觉：原始数据与权重不入库（只提交代码与索引脚本，见 HANDOFF_P1.md 第 7 节）----
data/raw/
data/datasets/
*.pth
*.pt
*.onnx
# ⚠️ safetensors 后缀必须排除：P1 预训练权重走 hf-mirror 下到 data/_weights/，
#    DINOv2 单个 346 MB、两个共约 368 MB，进了仓库会撑爆 git 历史。
*.safetensors
data/_weights/
data/_weights_b0/

# ---- 实验运行日志 ----
exp/*_run.log
exp/e2e_run_*.log
exp/e2e_*.log
# P1 D3 训练日志（stdout 冗余，结论已落在 exp/p1_d3_*.json）
exp/d3_*.log

# ---- 实验临时 id 清单（调试用，非证据）----
exp/_*.json
exp/_cache/
exp/d3_*.log
exp/p1_errors_part*.png
